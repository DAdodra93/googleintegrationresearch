# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
# Public base URL used to build OAuth redirect URIs (must match the URIs
# registered on the Google OAuth client).
PUBLIC_BASE_URL=http://localhost:8080

# ─── Data ────────────────────────────────────────────────────────────────────
# Postgres / Supabase connection string. Leave UNSET to run with the in-memory
# store (stub development only — nothing survives a restart).
# DATABASE_URL=postgres://user:pass@host:5432/gge

# 64 hex chars (32 bytes) — AES-256-GCM key for refresh-token encryption and
# OAuth state signing. Generate: openssl rand -hex 32
# Leave unset in stub mode to use an ephemeral per-process key.
# TOKEN_ENC_KEY=

# ─── Google OAuth (shared plumbing; scopes are per-module) ──────────────────
# Leave unset to run in GOOGLE STUB MODE (fake consent + fake tokens; every
# flow still runs end to end).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Google Ads / MCC wiring (Ads module) ───────────────────────────────────
# All three + GOOGLE_CLIENT_ID/SECRET set → real Google Ads gateway.
# Any missing → stub gateway (simulated Ads environment, fully functional).
# ADS_DEVELOPER_TOKEN=
# ADS_MCC_CUSTOMER_ID=            # digits only, e.g. 1234567890
# ADS_MCC_REFRESH_TOKEN=          # operator OAuth refresh token (adwords scope)
                                  # for the MCC user — obtain once via the
                                  # console's Ads connect flow on an operator
                                  # merchant, or any OAuth playground

# ─── AI provider (OpenAI-family default; stub when unset) ───────────────────
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Billing model ───────────────────────────────────────────────────────────
# interim = we fund spend via our payments profile (manual UI step per account)
# invoiced = future consolidated-invoicing model (stub only — not implemented)
BILLING_MODEL=interim

# ─── Tenant defaults (India-first) ───────────────────────────────────────────
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
